# Copy this file to .env for local development. Keep .env out of version control.
MONGODB_URI=
MONGODB_DATABASE=MandateShield

# Generate a unique secret locally; do not reuse this blank template value.
MANDATESHIELD_JWT_SECRET=

# Optional merchant enrichment. Core demo flows work without these values.
MANDATESHIELD_CHAT_MODEL=none
MANDATESHIELD_GEMINI_MODEL=gemini-3.8-flash
GOOGLE_GENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mandateshield-merchants
PINECONE_INDEX_HOST=
